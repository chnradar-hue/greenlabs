function getP(){return parseInt(document.getElementById('personen').value)||2;}
function getR(){return document.getElementById('ruimte').value;}
function getK(){return document.getElementById('klimaat').value;}
function shiftK(k,s){if(!s)return k;const n=k.length;return k.map((_,i)=>k[((i-s)%n+n)%n]);}
function filtP(){const r=getR();return PL.filter(p=>r==='klein'?p.r==='klein':r==='middel'?p.r!=='groot':true);}

function buildTasks(){
  const s=KLIM[getK()].s,pl=filtP(),tasks=[];
  pl.forEach(p=>{
    const k=shiftK(p.k,s),c=k[cm],q=Math.max(1,Math.round(p.p*getP()));
    if(c.includes('Z'))tasks.push({id:`z${p.n}`,e:p.e,name:p.n,sub:p.zt,type:'z',qty:`${q} ${p.u}`});
    if(c.includes('V'))tasks.push({id:`v${p.n}`,e:p.e,name:p.n,sub:p.vt,type:'v',qty:`${q} ${p.u}`});
    if(c.includes('O'))tasks.push({id:`o${p.n}`,e:p.e,name:p.n,sub:p.ot,type:'o',qty:`${q} ${p.u}`,crop:p.n});
  });
  document.getElementById('taskBadge').textContent=tasks.length;
  document.getElementById('taskCount').textContent=tasks.length;
  const tl={'z':'Zaaien','v':'Uitplanten','o':'Oogsten'};
  document.getElementById('taskFeed').innerHTML=tasks.length?tasks.map(t=>{
    const harvestBtn=t.type==='o'?`<button class="harvest-btn" onclick="event.stopPropagation();logHarvest('${t.crop}')">＋ Oogst loggen${harvestLog[t.crop]?` (${harvestLog[t.crop]}×)`:''}</button>`:'';
    return `
    <div class="task-card${doneTasks.has(t.id)?' done':''}" onclick="toggleTask('${t.id}')">
      <div class="tc-check">${doneTasks.has(t.id)?'✓':''}</div>
      <div class="tc-emoji">${t.e}</div>
      <div class="tc-info"><div class="tc-name">${t.name} — ${t.qty}</div><div class="tc-sub">${t.sub}</div>${harvestBtn}</div>
      <div class="tc-type type-${t.type}">${tl[t.type]}</div>
    </div>`;}).join(''):`<div style="text-align:center;padding:28px;color:var(--muted);font-size:0.84rem">Geen taken deze maand. Genieten! 🌿</div>`;
}
function logHarvest(crop){
  harvestLog[crop]=(harvestLog[crop]||0)+1;
  buildTasks();updateMeter();buildStats();buildHarvestSummary();saveState();
}
function buildHarvestSummary(){
  const el=document.getElementById('harvestSummary');
  if(!el)return;
  const entries=Object.entries(harvestLog).filter(([k,v])=>v>0);
  if(!entries.length){el.innerHTML='Nog niets geoogst. Log je oogst op het Dashboard om je supermarkt-meter te laten groeien! 🌱';return;}
  const total=entries.reduce((a,[,v])=>a+v,0);
  el.innerHTML=`<strong style="color:var(--forest)">${total} keer geoogst dit seizoen 🎉</strong><br>`+
    entries.sort((a,b)=>b[1]-a[1]).map(([k,v])=>{
      const plant=PL.find(p=>p.n===k);
      return `${plant?plant.e:'🌿'} ${k}: ${v}×`;
    }).join(' · ');
}
function toggleTask(id){if(doneTasks.has(id))doneTasks.delete(id);else doneTasks.add(id);buildTasks();saveState();}

function buildStats(){
  const p=calcPct(),pl=filtP();
  const oogstN=pl.filter(x=>{const k=shiftK(x.k,KLIM[getK()].s);return k[cm].includes('O');}).length;
