const STORE_KEY='greenlabs_v1';
function saveState(){
  try{
    const data={
      personen:document.getElementById('personen').value,
      ruimte:document.getElementById('ruimte').value,
      klimaat:document.getElementById('klimaat').value,
      doneTasks:[...doneTasks],
      doneMonth:cm,
