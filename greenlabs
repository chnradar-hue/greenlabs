function exportAgenda(){
  const s=KLIM[getK()].s,pl=filtP();
  const yr=new Date().getFullYear(),mo=String(cm+1).padStart(2,'0');
  let ics=`BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:-//Greenlabs//NL\n`;
  pl.forEach(p=>{
    const k=shiftK(p.k,s),c=k[cm],q=Math.max(1,Math.round(p.p*getP())),dt=`${yr}${mo}15`;
    const ev=(sum,desc)=>`BEGIN:VEVENT\nDTSTART;VALUE=DATE:${dt}\nDTEND;VALUE=DATE:${dt}\nSUMMARY:${sum}\nDESCRIPTION:${desc}\nEND:VEVENT\n`;
    if(c.includes('Z'))ics+=ev(`🌱 Zaaien: ${p.n}`,`${p.zt} — ${q} ${p.u}`);
    if(c.includes('V'))ics+=ev(`🪴 Uitplanten: ${p.n}`,`${p.vt} — ${q} ${p.u}`);
    if(c.includes('O'))ics+=ev(`🧺 Oogsten: ${p.n}`,p.ot);
  });
  ics+=`END:VCALENDAR`;
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([ics],{type:'text/calendar'}));
  a.download=`greenlabs-${ML[cm].toLowerCase()}.ics`;a.click();
}

