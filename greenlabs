// ══════════ LOCATIE + WEER ══════════
async function detectLoc(){
  const pill=document.getElementById('locPill');
  pill.textContent='📍 Ophalen...';
  if(!navigator.geolocation){pill.textContent='📍 N.v.t.';return;}
  navigator.geolocation.getCurrentPosition(async pos=>{
    userLat=pos.coords.latitude;userLon=pos.coords.longitude;
    try{
      const r=await fetch(`https://nominatim.openstreetmap.org/reverse?lat=${userLat}&lon=${userLon}&format=json`);
      const d=await r.json();
      const stad=d.address?.city||d.address?.town||d.address?.village||'';
      const land=d.address?.country||'';
      pill.textContent=`📍 ${stad||land}`;
      const cc=(d.address?.country_code||'').toLowerCase();
      const med=['es','pt','it','gr','hr','me','al','mk','ba','rs','mt','cy','ma','tn','tr'];
      const koud=['no','se','fi','is','ee','lv','lt','ca'];
      const trop=['th','id','my','ph','vn','sg','br','pe','co','mx','in','gh','ng','ke'];
      let z='gematigd';
      if(med.includes(cc))z='mediterraan';
      else if(koud.includes(cc))z='koud';
      else if(trop.includes(cc))z='tropisch';
      document.getElementById('klimaat').value=z;
      renderAll();
    }catch(e){pill.textContent='📍 Fout';}
    fetchWeer();
  },()=>{pill.textContent='📍 Geen toegang';});
}

function wcEmoji(wc){if(wc<=1)return'☀️';if(wc<=3)return'⛅';if(wc<=49)return'☁️';if(wc<=67)return'🌧️';if(wc<=77)return'❄️';if(wc<=82)return'🌦️';return'⛈️';}
function wcText(wc){if(wc<=1)return'Zonnig';if(wc<=3)return'Licht bewolkt';if(wc<=49)return'Bewolkt';if(wc<=67)return'Regen';if(wc<=77)return'Sneeuw';if(wc<=82)return'Buien';return'Onweer';}
const DAGNM=['Zo','Ma','Di','Wo','Do','Vr','Za'];

async function fetchWeer(){
  if(!userLat||!userLon)return;
  try{
    const url=`https://api.open-meteo.com/v1/forecast?latitude=${userLat}&longitude=${userLon}&current=temperature_2m,weathercode,relative_humidity_2m,windspeed_10m&daily=weathercode,temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=auto&forecast_days=7`;
    const res=await fetch(url);const d=await res.json();
    const c=d.current,t=Math.round(c.temperature_2m),wc=c.weathercode;
    document.getElementById('weatherWidget').innerHTML=`<div class="weather-icon">${wcEmoji(wc)}</div><div><div class="weather-temp">${t}°C</div><div class="weather-desc">${wcText(wc)}</div><div class="weather-extra">💧${c.relative_humidity_2m}% · 💨${Math.round(c.windspeed_10m)}km/u</div></div>`;
    if(d.daily){
      document.getElementById('forecastRow').innerHTML=d.daily.time.map((dt,i)=>{
        const day=new Date(dt),dn=i===0?'Vandaag':i===1?'Morgen':DAGNM[day.getDay()];
        return`<div class="fc-card"><div class="fc-day">${dn}</div><div class="fc-ico">${wcEmoji(d.daily.weathercode[i])}</div><div class="fc-tmp">${Math.round(d.daily.temperature_2m_max[i])}°/${Math.round(d.daily.temperature_2m_min[i])}°</div><div class="fc-rain">🌧 ${d.daily.precipitation_probability_max[i]||0}%</div></div>`;
      }).join('');
      const maxR=Math.max(...d.daily.precipitation_probability_max),maxT=Math.max(...d.daily.temperature_2m_max),minT=Math.min(...d.daily.temperature_2m_min);
      let tips=[];
      if(maxR>70)tips.push('🌧️ <strong>Veel neerslag</strong> — stel water geven uit, check afwatering potten.');
      else if(maxR<20&&maxT>22)tips.push('☀️ <strong>Droog & warm</strong> — water geven voor 9u of na 18u.');
      if(maxT>28)tips.push('🥵 <strong>Hittegolf</strong> — mulch de grond, bescherm sla en komkommer.');
      if(minT<5&&minT>0)tips.push('🥶 <strong>Lichte nachtvorst mogelijk</strong> — bescherm jonge zaailingen met vlies.');
      if(minT<=0)tips.push('❄️ <strong>Nachtvorst!</strong> — breng vorstgevoelige planten naar binnen vanavond!');
      if(!tips.length)tips.push('🌤️ Normale tuinomstandigheden. Houd je reguliere taken aan.');
      document.getElementById('weatherTips').innerHTML=tips.join('<br><br>');
    }
  }catch(e){document.getElementById('weatherWidget').innerHTML='<div style="font-size:0.78rem;opacity:0.6">Weerdata niet beschikbaar</div>';}
}

// ══════════ METER ══════════
function calcPct(){
  const r=document.getElementById('ruimte').value;
  const base={klein:28,middel:52,groot:78}[r]||40;
  const s=[8,10,16,28,38,54,63,63,48,32,14,8][cm];
  let pct=base*0.5+s*0.5;
  // Echte oogst-bonus: elke gelogde oogst telt mee (max +20%)
  const totalHarvests=Object.values(harvestLog).reduce((a,b)=>a+b,0);
  const harvestBonus=Math.min(20,totalHarvests*2);
  pct=pct*0.8+harvestBonus+ (base*0.5+s*0.5)*0.2;
  return Math.min(98,Math.round(pct));
}
function updateMeter(){
  const p=calcPct();
  document.getElementById('superPct').textContent=p+'%';
  setTimeout(()=>document.getElementById('meterFill').style.width=p+'%',120);
}

