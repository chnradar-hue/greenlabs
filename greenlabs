function buildVsel(){document.getElementById('vsel').innerHTML=filtP().map(p=>`<div class="vc${selVeg.includes(p.n)?' sel':''}" onclick="togV('${p.n}',this)">${p.e} ${p.n}</div>`).join('');}
function togV(n,el){const i=selVeg.indexOf(n);if(i>=0){selVeg.splice(i,1);el.classList.remove('sel');}else{selVeg.push(n);el.classList.add('sel');}}
async function loadKeuken(){
  if(!selVeg.length){alert('Selecteer minstens één groente.');return;}
  kResp={};activeKTab=null;
  document.getElementById('kres').style.display='block';
  document.getElementById('kcon').innerHTML=`<div class="spin-wrap"><div class="spinner"></div><br>AI denkt mee...</div>`;
  const cats=[
    {id:'bewaar',l:'📦 Bewaren',q:`Bewaartips voor: ${selVeg.join(', ')}. Per groente: houdbaarheid, methode, tekenen van bederf. HTML met <h4> per groente, <ul>. Nederlands.`},
    {id:'recept',l:'🍽️ Recepten',q:`3 gezonde recepten met: ${selVeg.join(', ')}. Per recept: naam, beschrijving, ingrediënten, tijd. HTML <h4> per recept. Nederlands.`},
    {id:'conserv',l:'🫙 Conserveren',q:`Conserveren voor winter: ${selVeg.join(', ')}. Invriezen, fermenteren, inmaken, drogen. HTML <h4> per methode. Nederlands.`},
  ];
  document.getElementById('rtabs').innerHTML=cats.map(c=>`<button class="rtab" id="rt-${c.id}" onclick="showKTab('${c.id}')">${c.l}</button>`).join('');
  cats.forEach(c=>fetchKeuken(c));showKTab('bewaar');
}
async function fetchKeuken(cat){
  try{
    const res=await fetch('https://api.anthropic.com/v1/messages',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:'claude-sonnet-4-6',max_tokens:1000,messages:[{role:'user',content:cat.q}]})});
    const d=await res.json();kResp[cat.id]=d.content?.map(c=>c.text||'').join('')||'Geen resultaat.';
    if(activeKTab===cat.id)showKTab(cat.id);
  }catch(e){kResp[cat.id]='<p>Laden mislukt.</p>';if(activeKTab===cat.id)showKTab(cat.id);}
}
function showKTab(id){
  activeKTab=id;
  document.querySelectorAll('.rtab').forEach(t=>t.classList.remove('active'));
  const el=document.getElementById('rt-'+id);if(el)el.classList.add('active');
  document.getElementById('kcon').innerHTML=kResp[id]||`<div class="spin-wrap"><div class="spinner"></div><br>Laden...</div>`;
}

