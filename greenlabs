}
function loadState(){
  try{
    const raw=localStorage.getItem(STORE_KEY);
    if(!raw)return false;
    const d=JSON.parse(raw);
    if(d.personen)document.getElementById('personen').value=d.personen;
    if(d.ruimte)document.getElementById('ruimte').value=d.ruimte;
    if(d.klimaat)document.getElementById('klimaat').value=d.klimaat;
